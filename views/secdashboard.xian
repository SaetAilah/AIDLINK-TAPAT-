{{> head}}
<body class="bg-gray-50 min-h-screen">
  <!-- Header -->
  <header class="bg-white shadow-sm border-b">
    <div class="container mx-auto px-6 py-4">
      <div class="flex justify-between items-center">
        <div>
          <h1 class="text-2xl font-bold text-gray-800">Barangay Aid Distribution System</h1>
          <p class="text-gray-600">Secretary Dashboard</p>
        </div>
        <div class="text-right">
          <p class="text-gray-800 font-semibold">Welcome, {{user.fullname}}</p>
          <p class="text-sm text-gray-600">Role: {{user.role}}</p>
        </div>
      </div>
    </div>
  </header>

  <div class="container mx-auto p-6">

    <!-- Success/Error Messages -->
    {{#if success}}
    <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-lg">
      <p class="text-green-700">{{success}}</p>
    </div>
    {{/if}}
    
    {{#if error}}
    <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
      <p class="text-red-700">{{error}}</p>
    </div>
    {{/if}}

    <!-- Quick Stats -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
      <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-green-500">
        <div class="flex items-center">
          <div class="bg-green-100 p-3 rounded-full">
            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-gray-600">Sitios</p>
            <p class="text-2xl font-bold text-gray-800">{{stats.totalSitios}}</p>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-purple-500">
        <div class="flex items-center">
          <div class="bg-purple-100 p-3 rounded-full">
            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-gray-600">BHW Workers</p>
            <p class="text-2xl font-bold text-gray-800">{{stats.totalBHW}}</p>
          </div>
        </div>
      </div>

    </div>

    <!-- Main Actions Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8 items-stretch">

      <!-- Register Resident Card -->
      <div class="bg-white rounded-lg shadow-md overflow-hidden h-full flex flex-col">
        <div class="bg-blue-600 px-6 py-4">
          <h2 class="text-xl font-bold text-white">Register New Resident</h2>
          <p class="text-blue-100">Add new residents to the barangay database</p>
        </div>
        <div class="p-6 flex-1">
          <p class="text-gray-600 mb-4">Register new residents and assign them to specific sitios for proper health monitoring and assistance.</p>
          
          <!-- Register Resident Form -->
<form method="POST" action="/secretary/add-resident" class="space-y-4" id="registerForm">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <!-- Existing Fields -->
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">First Name *</label>
      <input type="text" name="firstName" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Last Name *</label>
      <input type="text" name="lastName" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Birthdate *</label>
      <input type="date" name="birthdate" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Gender *</label>
      <select name="gender" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
        <option value="">Select Gender</option>
        <option value="male">Male</option>
        <option value="female">Female</option>
      </select>
    </div>
    <div class="md:col-span-2">
      <label class="block text-sm font-medium text-gray-700 mb-1">Address *</label>
      <input type="text" name="address" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Sitio *</label>
      <select name="sitioId" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
        <option value="">Select Sitio</option>
        {{#each sitios}}
          <option value="{{this.id}}">{{this.name}}</option>
        {{/each}}
      </select>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Contact Number</label>
      <input type="tel" name="contactNumber" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
    </div>

    <!-- New Fields -->
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Occupancy</label>
      <input type="text" name="occupancy" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Monthly Income</label>
      <input type="number" name="monthlyIncome" min="0" step="0.01" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Marital Status</label>
      <select name="maritalStatus" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
        <option value="">Select Status</option>
        <option value="single">Single</option>
        <option value="married">Married</option>
        <option value="widowed">Widowed</option>
        <option value="divorced">Divorced</option>
      </select>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Highest Level of Education</label>
      <select name="educationLevel" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
        <option value="">Select Level</option>
        <option value="none">None</option>
        <option value="elementary">Elementary</option>
        <option value="highschool">High School</option>
        <option value="college">College</option>
        <option value="graduate">Graduate</option>
      </select>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Number of Children</label>
      <input type="number" name="numChildren" min="0" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
    </div>
  </div>

  <div class="flex justify-end space-x-3 pt-4">
    <button type="reset" class="bg-gray-500 text-white px-4 py-2 rounded-lg hover:bg-gray-600 transition duration-200">
      Clear
    </button>
    <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 transition duration-200 font-semibold">
      Register Resident
    </button>
  </div>
</form>

        </div>
      </div>

    <!-- BHW Personnel Overview -->
      <div class="bg-white rounded-lg shadow-md overflow-hidden h-full flex flex-col">
      <div class="bg-purple-600 px-6 py-4">
        <h2 class="text-xl font-bold text-white">BHW Personnel</h2>
        <p class="text-purple-100">Assign sitios to BHW workers quickly with the dropdown list.</p>
      </div>
      <div class="p-6 flex-1">
        <div class="space-y-4">
          {{#each bhws}}
          <div class="border border-gray-200 rounded-lg p-4 bg-gray-50">
            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-3 mb-3">
              <div>
                <p class="font-semibold text-gray-800">{{this.fullname}}</p>
                {{#if this.assignedSitio}}
                  <p class="text-sm text-green-700">Currently assigned to {{this.assignedSitio}}</p>
                {{else}}
                  <p class="text-sm text-yellow-700">No sitio assigned yet</p>
                {{/if}}
                <p class="text-xs text-gray-500 mt-1">Total Sitios: {{../sitios.length}}</p>
              </div>
              <form method="POST" action="/secretary/assign-bhw" class="flex flex-wrap gap-2 items-center">
                <input type="hidden" name="bhwId" value="{{this.id}}">
                <select name="sitioId" required class="px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 text-sm min-w-[180px]">
                  <option value="">Select Sitio</option>
                  {{#each ../sitios}}
                    <option value="{{this.id}}" {{#if (eq this.id ../assignedSitioId)}}selected{{/if}}>{{this.name}}</option>
                  {{/each}}
                </select>
                <button type="submit" class="bg-purple-600 text-white px-4 py-2 rounded-lg hover:bg-purple-700 transition duration-200 text-sm">Assign</button>
              </form>
            </div>
          </div>
          {{/each}}
        </div>
      </div>
    </div>
  </div>

    <!-- Registered Residents Overview -->
    <div class="bg-white rounded-lg shadow-md overflow-hidden mb-8 w-full">
      <div class="bg-blue-600 px-6 py-4">
        <h2 class="text-xl font-bold text-white">Registered Residents</h2>
        <p class="text-blue-100">Review approved and pending residents separately for clarity.</p>
      </div>
      <div class="p-6">
        <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
          <div class="border border-gray-200 rounded-lg p-4">
            <h3 class="text-lg font-semibold text-gray-800 mb-3">Pending / Unapproved</h3>
            <div class="space-y-3">
              {{#each residents}}
                {{#unless (eq this.status 'approved')}}
                <div class="bg-gray-50 rounded-lg p-4">
                  <p class="font-medium text-gray-800">{{this.fullName}}</p>
                  <p class="text-sm text-gray-500">{{this.sitioName}}</p>
                  <p class="text-xs text-gray-500 mb-2">Status: {{this.status}}</p>
                  <div class="flex flex-wrap gap-2">
                    <form method="POST" action="/secretary/resident-status/{{this.id}}" class="inline">
                      <input type="hidden" name="status" value="approved">
                      <button type="submit" class="bg-green-600 text-white px-3 py-1 rounded text-sm hover:bg-green-700 transition duration-200">Approve</button>
                    </form>
                    <form method="POST" action="/secretary/resident-status/{{this.id}}" class="inline">
                      <input type="hidden" name="status" value="rejected">
                      <button type="submit" class="bg-red-600 text-white px-3 py-1 rounded text-sm hover:bg-red-700 transition duration-200">Reject</button>
                    </form>
                  </div>
                </div>
                {{/unless}}
              {{/each}}
            </div>
          </div>

          <div class="border border-gray-200 rounded-lg p-4">
            <h3 class="text-lg font-semibold text-gray-800 mb-3">Approved Residents</h3>
            <div class="space-y-3">
              {{#each residents}}
                {{#if (eq this.status 'approved')}}
                <div class="bg-gray-50 rounded-lg p-4">
                  <div class="flex justify-between items-start gap-4">
                    <div>
                      <p class="font-medium text-gray-800">{{this.fullName}}</p>
                      <p class="text-sm text-gray-500">{{this.sitioName}}</p>
                    </div>
                    <span class="text-xs bg-green-100 text-green-800 px-2 py-1 rounded-full">Approved</span>
                  </div>
                </div>
                {{/if}}
              {{/each}}
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Keep Recent Activity & Census sections here -->
    
    <!-- Footer Actions -->
    <div class="mt-8 flex justify-end space-x-4">
      <a href="/logout" class="bg-red-600 text-white px-6 py-3 rounded-lg hover:bg-red-700 transition duration-200 font-semibold flex items-center">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
        </svg>
        Logout
      </a>
    </div>
  </div>
  <!-- Newly Registered Residents Table (Initially Hidden) -->
<div id="newResidentsSection" class="bg-white rounded-lg shadow-md overflow-hidden mt-8 hidden">
  <div class="bg-gray-800 px-6 py-4">
    <h2 class="text-xl font-bold text-white">Newly Registered Residents</h2>
  </div>
  <div class="p-6">
    <table class="min-w-full table-auto border border-gray-300">
      <thead>
        <tr class="bg-gray-100">
          <th class="border px-4 py-2 text-left">Full Name</th>
          <th class="border px-4 py-2 text-left">Birthdate</th>
          <th class="border px-4 py-2 text-left">Gender</th>
          <th class="border px-4 py-2 text-left">Address</th>
          <th class="border px-4 py-2 text-left">Sitio</th>
          <th class="border px-4 py-2 text-left">Contact Number</th>
          <th class="border px-4 py-2 text-left">Occupancy</th>
          <th class="border px-4 py-2 text-left">Monthly Income</th>
          <th class="border px-4 py-2 text-left">Marital Status</th>
          <th class="border px-4 py-2 text-left">Education</th>
          <th class="border px-4 py-2 text-left">Children</th>

        </tr>
      </thead>
      <tbody id="newResidentsTableBody">
        <!-- New residents will be appended here dynamically -->
      </tbody>
    </table>
  </div>
</div>

<script>
// ---- FORM VALIDATION ONLY ----
// Removed localStorage code - all data now saves to database
document.getElementById('registerForm').addEventListener('submit', function (e) {
  const formData = new FormData(this);

  // Validate required fields before submission
  const requiredFields = ['firstName', 'lastName', 'birthdate', 'gender', 'address', 'sitioId'];
  for (let field of requiredFields) {
    if (!formData.get(field)) {
      e.preventDefault();
      alert(`Please fill in the ${field} field`);
      return;
    }
  }
  
  // All fields valid - form will submit normally to server
  console.log('✅ Form submitting to server...');
});
</script>

<script>
// ---- BHW ASSIGNMENT HANDLER ----
document.querySelectorAll('form[action="/secretary/assign-bhw"]').forEach(form => {
  form.addEventListener('submit', function(e) {
    const bhwInput = this.querySelector('input[name="bhwId"]');
    const bhwId = bhwInput ? bhwInput.value : null;

    if (!bhwId) {
      e.preventDefault();
      alert("Please select a BHW to assign.");
      return;
    }

    // Form will submit normally to server
    console.log('✅ BHW assignment submitting to server...');
  });
});
</script>

<script>
  if (window.history.replaceState && window.location.search.length > 0) {
    const url = new URL(window.location);
    window.history.replaceState({}, document.title, url.pathname + url.hash);
  }
</script>

</body>
