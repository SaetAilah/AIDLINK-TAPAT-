{{> head}}
<body class="bg-gray-50 min-h-screen">
  <!-- Header -->
  <header class="bg-white shadow-sm border-b">
    <div class="container mx-auto px-6 py-4">
      <div class="flex justify-between items-center">
        <div>
          <h1 class="text-2xl font-bold text-gray-800">Barangay Health System</h1>
          <p class="text-gray-600">Resident Dashboard</p>
        </div>
        <div class="text-right">
          <p class="text-gray-800 font-semibold">Welcome, {{user.fullname}}</p>
          <p class="text-sm text-gray-600">Verified Residents List</p>
        </div>
      </div>
    </div>
  </header>

  <div class="container mx-auto p-6">
    <!-- Quick Stats -->
    <div class="grid grid-cols-1 gap-6 mb-8">
      <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-green-500">
        <div class="flex items-center">
          <div class="bg-green-100 p-3 rounded-full">
            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-gray-600">Total Verified Residents</p>
            <p class="text-2xl font-bold text-gray-800">{{verifiedResidents.length}}</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Resident Approval Status -->
    <div class="bg-white rounded-lg shadow-md overflow-hidden mb-6">
      <div class="bg-blue-600 px-6 py-4">
        <h2 class="text-xl font-bold text-white">Your Approval Status</h2>
        <p class="text-blue-100">See whether your name has been approved by the secretary</p>
      </div>
      <div class="p-6">
        {{#if currentResident}}
        <div class="flex items-center justify-between gap-4">
          <div>
            <p class="text-lg font-semibold text-gray-800">{{currentResident.firstName}} {{currentResident.lastName}}</p>
            <p class="text-sm text-gray-600">Sitio: {{currentResident.sitioName}}</p>
            <p class="text-sm text-gray-600">Assigned BHW: {{currentResident.bhwName}}</p>
          </div>
          <span class="px-3 py-1 rounded-full text-sm font-semibold {{#if (eq currentResident.status 'approved')}}bg-green-100 text-green-800{{else if (eq currentResident.status 'pending')}}bg-yellow-100 text-yellow-800{{else}}bg-red-100 text-red-800{{/if}}">
            {{currentResident.status}}
          </span>
        </div>
        {{else}}
        <p class="text-gray-600">We could not find your resident record yet. If you have already been registered, your name will appear here after approval.</p>
        {{/if}}
      </div>
    </div>

    <!-- Verified Residents List -->
    <div class="bg-white rounded-lg shadow-md overflow-hidden">
      <div class="bg-green-600 px-6 py-4">
        <h2 class="text-xl font-bold text-white">Verified Residents</h2>
        <p class="text-green-100">Complete list of verified residents in your sitio</p>
      </div>
      
      <div class="p-6">
        {{#if verifiedResidents.length}}
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Verified Residents
                  </th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Sitio
                  </th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Assigned BHW
                  </th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                {{#each verifiedResidents}}
                <tr class="hover:bg-gray-50">
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="flex items-center">
                      <div class="flex-shrink-0 h-10 w-10 bg-green-100 rounded-full flex items-center justify-center">
                        <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                      </div>
                      <div class="ml-4">
                        <div class="text-sm font-medium text-gray-900">{{this.firstName}} {{this.lastName}}</div>
                        <div class="text-sm text-gray-500">{{this.address}}</div>
                      </div>
                    </div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="px-3 py-1 inline-flex text-sm leading-5 font-semibold rounded-full bg-blue-100 text-blue-800">
                      {{this.sitioName}}
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="px-3 py-1 inline-flex text-sm leading-5 font-semibold rounded-full bg-purple-100 text-purple-800">
                      {{this.bhwName}}
                    </span>
                  </td>
                </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
          
          <!-- Summary -->
          <div class="mt-6 p-4 bg-green-50 border border-green-200 rounded-lg">
            <p class="text-green-800 text-center">
              <span class="font-semibold">{{verifiedResidents.length}}</span> verified resident{{#if (eq verifiedResidents.length 1)}}{{else}}s{{/if}} in all sitios
            </p>
          </div>
        {{else}}
          <div class="text-center py-12">
            <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
            </svg>
            <h3 class="text-lg font-semibold text-gray-800 mb-2">No Verified Residents Yet</h3>
            <p class="text-gray-600 max-w-md mx-auto">
              There are no verified residents at the moment. 
              The Barangay Health Workers are currently reviewing applications.
            </p>
          </div>
        {{/if}}
      </div>
    </div>

    <!-- Info Box -->
    <div class="mt-6 bg-yellow-50 border border-yellow-200 rounded-lg p-4">
      <div class="flex items-start">
        <svg class="w-5 h-5 text-yellow-600 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <div>
          <h4 class="font-semibold text-yellow-800">About This List</h4>
          <p class="text-yellow-700 text-sm mt-1">
            This shows all residents in your sitio who have been verified by the Barangay Health Worker 
            and are qualified to receive aid from the barangay. The list updates automatically when new residents are verified.
          </p>
        </div>
      </div>
    </div>

    <!-- Footer Actions -->
    <div class="mt-8 flex justify-end space-x-4">
      <a href="/logout" class="bg-red-600 text-white px-6 py-3 rounded-lg hover:bg-red-700 transition duration-200 font-semibold flex items-center">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
        </svg>
        Logout
      </a>
    </div>
  </div>

  <script>
    // Auto-refresh every 30 seconds to get updated list
    setInterval(() => {
      window.location.reload();
    }, 30000);
  </script>
</body>