{{> head}}
<body class="bg-gray-50 min-h-screen">
  <!-- Header -->
  <header class="bg-white shadow-sm border-b">
    <div class="container mx-auto px-6 py-4">
      <div class="flex justify-between items-center">
        <div>
          <h1 class="text-2xl font-bold text-gray-800">Barangay Health System</h1>
          <p class="text-gray-600">BHW Dashboard</p>
        </div>
        <div class="text-right">
          <p class="text-gray-800 font-semibold">Welcome, {{user.fullname}}</p>
          <p class="text-sm text-gray-600">BHW ID: {{user.bhwId}}</p>
        </div>
      </div>
    </div>
  </header>

  <div class="container mx-auto p-6">
    <!-- Quick Stats -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
      <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-green-500">
        <div class="flex items-center">
          <div class="bg-green-100 p-3 rounded-full">
            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
            </svg>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-gray-600">Assigned Sitio</p>
            <p class="text-xl font-bold text-gray-800">{{assignedSitio.name}}</p>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-blue-500">
        <div class="flex items-center">
          <div class="bg-blue-100 p-3 rounded-full">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"></path>
            </svg>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-gray-600">Total Residents</p>
            <p class="text-2xl font-bold text-gray-800">{{residents.length}}</p>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-purple-500">
        <div class="flex items-center">
          <div class="bg-purple-100 p-3 rounded-full">
            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-gray-600">Verified</p>
            <p class="text-2xl font-bold text-gray-800">{{verifiedCount}}</p>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-orange-500">
        <div class="flex items-center">
          <div class="bg-orange-100 p-3 rounded-full">
            <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-gray-600">Pending</p>
            <p class="text-2xl font-bold text-gray-800">{{pendingCount}}</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <!-- Residents List -->
      <div class="bg-white rounded-lg shadow-md">
        <div class="bg-blue-600 px-6 py-4">
          <h2 class="text-xl font-bold text-white">Residents in {{assignedSitio.name}}</h2>
          <p class="text-blue-100">Manage resident verification status</p>
        </div>
        <div class="p-6">
          <div class="space-y-4 max-h-96 overflow-y-auto">
            {{#each residents}}
            <div class="border border-gray-200 rounded-lg p-4 hover:bg-gray-50 transition duration-200">
              <div class="flex justify-between items-start mb-3">
                <div>
                  <h3 class="font-semibold text-gray-800">{{this.firstName}} {{this.lastName}}</h3>
                  <p class="text-sm text-gray-600">{{this.address}}</p>
                  <p class="text-xs text-gray-500">Age: {{calculateAge this.birthdate}} • {{this.gender}}</p>
                </div>
                <span class="{{getStatusColor this.status}} text-xs px-2 py-1 rounded-full font-semibold uppercase">
                  {{getStatusLabel this.status}}
                </span>
              </div>
              
              <div class="flex justify-between items-center">
                <div class="text-sm text-gray-600">
                  <p>Contact: {{this.contactNumber}}</p>
                  <p>Registered: {{formatDate this.createdAt}}</p>
                </div>
                <div class="flex space-x-2">
                  {{#if (eq this.status 'pending')}}
                  <form method="POST" action="/bhw/verify/{{this.id}}" class="inline">
                    <input type="hidden" name="status" value="approved">
                    <button type="submit" class="bg-green-600 text-white px-3 py-1 rounded text-sm hover:bg-green-700 transition duration-200 flex items-center">
                      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                      </svg>
                      Verify
                    </button>
                  </form>
                  <form method="POST" action="/bhw/verify/{{this.id}}" class="inline">
                    <input type="hidden" name="status" value="rejected">
                    <button type="submit" class="bg-red-600 text-white px-3 py-1 rounded text-sm hover:bg-red-700 transition duration-200 flex items-center">
                      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                      </svg>
                      Reject
                    </button>
                  </form>
                  {{else if (eq this.status 'approved')}}
                  <form method="POST" action="/bhw/verify/{{this.id}}" class="inline">
                    <input type="hidden" name="status" value="pending">
                    <button type="submit" class="bg-yellow-600 text-white px-3 py-1 rounded text-sm hover:bg-yellow-700 transition duration-200 flex items-center">
                      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                      </svg>
                      Set Pending
                    </button>
                  </form>
                  <form method="POST" action="/bhw/verify/{{this.id}}" class="inline">
                    <input type="hidden" name="status" value="rejected">
                    <button type="submit" class="bg-red-600 text-white px-3 py-1 rounded text-sm hover:bg-red-700 transition duration-200 flex items-center">
                      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                      </svg>
                      Reject
                    </button>
                  </form>
                  {{else if (eq this.status 'rejected')}}
                  <form method="POST" action="/bhw/verify/{{this.id}}" class="inline">
                    <input type="hidden" name="status" value="approved">
                    <button type="submit" class="bg-green-600 text-white px-3 py-1 rounded text-sm hover:bg-green-700 transition duration-200 flex items-center">
                      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                      </svg>
                      Verify
                    </button>
                  </form>
                  <form method="POST" action="/bhw/verify/{{this.id}}" class="inline">
                    <input type="hidden" name="status" value="pending">
                    <button type="submit" class="bg-yellow-600 text-white px-3 py-1 rounded text-sm hover:bg-yellow-700 transition duration-200 flex items-center">
                      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                      </svg>
                      Set Pending
                    </button>
                  </form>
                  {{/if}}
                </div>
              </div>
            </div>
            {{/each}}
          </div>
        </div>
      </div>

      <!-- Verification Overview -->
      <div class="bg-white rounded-lg shadow-md">
        <div class="bg-purple-600 px-6 py-4">
          <h2 class="text-xl font-bold text-white">Verification Overview</h2>
          <p class="text-purple-100">Aid distribution status</p>
        </div>
        <div class="p-6">
          <!-- Status Breakdown -->
          <div class="space-y-4 mb-6">
            <div class="flex justify-between items-center p-3 bg-green-50 rounded-lg">
              <div class="flex items-center">
                <div class="w-3 h-3 bg-green-500 rounded-full mr-3"></div>
                <span class="font-medium text-green-800">Approved for Aid</span>
              </div>
              <span class="font-bold text-green-800">{{verifiedCount}}</span>
            </div>
            
            <div class="flex justify-between items-center p-3 bg-yellow-50 rounded-lg">
              <div class="flex items-center">
                <div class="w-3 h-3 bg-yellow-500 rounded-full mr-3"></div>
                <span class="font-medium text-yellow-800">Pending Review</span>
              </div>
              <span class="font-bold text-yellow-800">{{pendingCount}}</span>
            </div>
            
            <div class="flex justify-between items-center p-3 bg-red-50 rounded-lg">
              <div class="flex items-center">
                <div class="w-3 h-3 bg-red-500 rounded-full mr-3"></div>
                <span class="font-medium text-red-800">Rejected</span>
              </div>
              <span class="font-bold text-red-800">{{rejectedCount}}</span>
            </div>
          </div>

          <!-- Quick Actions -->
          <div class="border-t pt-4">
            <h3 class="font-semibold text-gray-800 mb-3">Quick Actions</h3>
            <div class="space-y-2">
              <a href="/bhw/residents" class="block w-full bg-blue-600 text-white py-2 px-4 rounded text-center hover:bg-blue-700 transition duration-200">
                View All Residents
              </a>
              <button class="block w-full bg-green-600 text-white py-2 px-4 rounded text-center hover:bg-green-700 transition duration-200">
                Generate Report
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer Actions -->
    <div class="mt-8 flex justify-end space-x-4">
      <a href="/logout" class="bg-red-600 text-white px-6 py-3 rounded-lg hover:bg-red-700 transition duration-200 font-semibold flex items-center">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
        </svg>
        Logout
      </a>
    </div>
  </div>

  <script>
    // Auto-refresh residents list every 30 seconds
    setInterval(() => {
      window.location.reload();
    }, 30000);

    // Confirm before rejecting a resident
    document.addEventListener('submit', function(e) {
      if (e.target.querySelector('input[name="status"][value="rejected"]')) {
        if (!confirm('Are you sure you want to reject this resident for aid?')) {
          e.preventDefault();
        }
      }
    });
  </script>
</body>